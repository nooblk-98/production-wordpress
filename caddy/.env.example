CADDY_EMAIL=admin@example.com
# Main domain (supports multiple domains separated by spaces)
SITE_HOST=localhost
# Example for multiple domains:
# SITE_HOST=www.sample.com sample.com

# Upstream target: Varnish container on shared wp_net Docker network
# Default points to wp_varnish:6081 in production-wordpress stack
UPSTREAM=wp_varnish:6081

# Request body hard limit
MAX_BODY_SIZE=25MB

# Plugin: Rate Limiting (requests per minute per IP)
# Set to 'true' to enable, comment out rate_limit block in Caddyfile to disable
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EVENTS=100
RATE_LIMIT_WINDOW=1m
