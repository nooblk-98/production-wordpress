CADDY_EMAIL=admin@example.com
SITE_HOST=localhost

# Upstream target (existing stack). Current setup proxies to Varnish on host port 80.
UPSTREAM=host.docker.internal:80

# Host ports exposed by this standalone Caddy stack
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Request body hard limit
MAX_BODY_SIZE=25MB
